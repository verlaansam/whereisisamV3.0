# Example environment variables file
# Copy this to .env and fill in your production values
# NEVER commit .env to version control

# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here-change-this-in-production
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database (PostgreSQL)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@db.example.com:5432/whereissam

# CORS Settings
# Your frontend URL
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Security Headers
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Static and Media Files
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media

# Logging
DJANGO_LOG_FILE=/var/log/django/app.log
DJANGO_LOG_LEVEL=INFO

# Optional: Sentry for error tracking
# SENTRY_DSN=your-sentry-dsn-here

# Optional: Email Configuration for Django
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Frontend URL (for frontend environment variables)
REACT_APP_API_URL=https://api.yourdomain.com
